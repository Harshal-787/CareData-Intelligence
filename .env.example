# ==========================================
# CareData Intelligence - Environment Variables
# ==========================================

# ------------------------------------------
# Google Gemini API Key (Required for Phase 4 NL2SQL)
# Get a key from: https://aistudio.google.com/app/apikey
# ------------------------------------------
GEMINI_API_KEY="your_api_key_here"

# ------------------------------------------
# Database Configuration (Postgres)
# ------------------------------------------
POSTGRES_USER=caredata_admin
POSTGRES_PASSWORD=caredata_secure_pass123
POSTGRES_DB=caredata_db

# ------------------------------------------
# Object Storage Configuration (MinIO)
# ------------------------------------------
MINIO_ROOT_USER=caredata_minio
MINIO_ROOT_PASSWORD=caredata_minio_secret123

# ------------------------------------------
# Internal Service Routing
# ------------------------------------------
PORT=8080
REDIS_HOST=redis
DATA_ENGINE_URL=http://data-engine:8000
